# ==============================================================================
# GC NET HUB - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Petunjuk Keamanan:
# 1. Salin file ini menjadi .env.local untuk penggunaan lokal (pengembangan).
# 2. File .env.local WAJIB masuk .gitignore dan DILARANG KERAS di-commit ke Git.
# 3. Variabel dengan awalan NEXT_PUBLIC_ akan terekspos ke browser pengguna.
# 4. Variabel TANPA awalan NEXT_PUBLIC_ bersifat rahasia server (Zero Leakage).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Kunci master backend (Rahasia Server, JANGAN pernah beri awalan NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. ADMIN & KASIR CREDENTIALS
# ------------------------------------------------------------------------------
# Akun master fallback saat database belum siap
ADMIN_USERNAME=gcnet
ADMIN_PASSWORD=ganti_dengan_password_admin_kuat

# Salt rahasia untuk tanda tangan HMAC-SHA256 session token kasir
ADMIN_SESSION_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter

# ------------------------------------------------------------------------------
# 3. MASTER OWNER PASSKEY (PENGAMANAN TINGKAT DUA)
# ------------------------------------------------------------------------------
# Passkey rahasia khusus pemilik untuk membuka menu super sensitif (Kelola Akun Staf)
# Hanya diketahui oleh Owner / Galang, tidak boleh dibagikan ke staf kasir biasa
OWNER_PASSKEY=ganti_dengan_passkey_rahasia_pemilik

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY DANA QRIS (OPSIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# Dapatkan dari: DANA Developer Portal
DANA_BASE_URL=https://api.sandbox.dana.id
DANA_CLIENT_ID=your_dana_client_id
DANA_CLIENT_SECRET=your_dana_client_secret
DANA_MERCHANT_ID=your_dana_merchant_id
DANA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
DANA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
