# ==============================================================================
# GC NET HUB - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Petunjuk Keamanan:
# 1. Salin file ini menjadi .env.local untuk penggunaan lokal (pengembangan).
# 2. File .env.local WAJIB masuk .gitignore dan DILARANG KERAS di-commit ke Git.
# 3. Variabel dengan awalan NEXT_PUBLIC_ akan terekspos ke browser pengguna.
# 4. Variabel TANPA awalan NEXT_PUBLIC_ bersifat rahasia server (Zero Leakage).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Kunci master backend (Rahasia Server, JANGAN pernah beri awalan NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. ADMIN & KASIR CREDENTIALS
# ------------------------------------------------------------------------------
# Akun master fallback saat database belum siap
ADMIN_USERNAME=gcnet
ADMIN_PASSWORD=ganti_dengan_password_admin_kuat

# Salt rahasia untuk tanda tangan HMAC-SHA256 session token kasir
ADMIN_SESSION_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter

# ------------------------------------------------------------------------------
# 3. MASTER OWNER PASSKEY (PENGAMANAN TINGKAT DUA)
# ------------------------------------------------------------------------------
# Passkey rahasia khusus pemilik untuk membuka menu super sensitif (Kelola Akun Staf)
# Hanya diketahui oleh Owner / Galang, tidak boleh dibagikan ke staf kasir biasa
OWNER_PASSKEY=ganti_dengan_passkey_rahasia_pemilik

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY MIDTRANS SNAP (OPSIONAL)
# ------------------------------------------------------------------------------
# Dapatkan dari: Midtrans Dashboard -> Settings -> Access Keys
# Server key diawali "Mid-server-". Jangan salin nama key seperti "M123-DEFAULT-PAYMENT-CLIENT".
# Sandbox: dashboard.sandbox.midtrans.com, production: dashboard.midtrans.com. Key keduanya beda.
# Selain "true" dianggap sandbox, jadi lupa isi tidak pernah memotong uang sungguhan.
# Notification URL di dashboard: https://<domain>/api/webhooks/midtrans
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxx
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# 5. INVOICE EMAIL (OPSIONAL, RESEND)
# ------------------------------------------------------------------------------
# Tanpa ini booking tetap jalan, invoice saja yang tidak dikirim.
# Pengirim wajib dari domain yang sudah diverifikasi di resend.com/domains.
RESEND_API_KEY=re_xxxxxxxx
INVOICE_FROM_EMAIL=GC Net <invoice@domainlu.id>
# URL web untuk link "Cek posisi antrean" di email. Di Vercel otomatis dari domain production.
NEXT_PUBLIC_SITE_URL=https://domainlu.id

# ------------------------------------------------------------------------------
# 6. WATCHER PC (OPSIONAL, feed sisa waktu dari billing GBilling)
# ------------------------------------------------------------------------------
# Token rahasia buat scripts/gb-watcher.ps1. Samakan nilainya di config watcher.
PC_SYNC_TOKEN=ganti-dengan-token-acak-panjang
